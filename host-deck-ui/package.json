{
  "name": "host-deck-ui",
  "private": true,
  "version": "0.3.1",
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "build:webos": "pnpm --filter @host-deck/webos build",
    "test:webos": "pnpm --filter @host-deck/webos test",
    "test:webos-demo": "pnpm build:webos && pnpm --filter @host-deck/webos-demo test",
    "verify:webos-package": "pnpm build:webos && node scripts/verify-webos-package.mjs",
    "dev:webos-demo": "pnpm build:webos && pnpm --filter @host-deck/webos-demo dev",
    "build:webos-demo": "pnpm build:webos && pnpm --filter @host-deck/webos-demo build",
    "dev": "pnpm build:webos && vite",
    "sync:version": "node scripts/sync-version.mjs",
    "release": "sh ../scripts/release.sh",
    "build": "pnpm build:webos && vite build",
    "build:assets": "node scripts/build-assets.mjs",
    "format": "prettier --write . \"!packages/webos/**\" --ignore-path ../.prettierignore",
    "format:check": "prettier --check . \"!packages/webos/**\" --ignore-path ../.prettierignore",
    "test": "pnpm build:webos && vitest run --project host",
    "test:dev-tls": "pnpm build:webos && node --test scripts/dev-tls.integration.test.mjs",
    "preview": "vite preview"
  },
  "dependencies": {
    "@host-deck/webos": "workspace:*",
    "@lucide/vue": "^1.21.0",
    "@tanstack/vue-query": "^5.97.0",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "@vueuse/core": "^14.2.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "axios": "^1.15.0",
    "dompurify": "^3.4.15",
    "echarts": "^6.0.0",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.13",
    "monaco-editor": "^0.55.1",
    "pinia": "^3.0.4",
    "qrcode": "^1.5.4",
    "vue": "^3.5.32",
    "vue-echarts": "^8.0.1",
    "xgplayer": "^3.0.24",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^24.12.2",
    "@types/qrcode": "^1.5.6",
    "@vicons/carbon": "^0.13.0",
    "@vicons/fluent": "^0.13.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "jsdom": "^29.1.1",
    "naive-ui": "^2.44.1",
    "prettier": "3.8.4",
    "typescript": "~6.0.2",
    "unocss": "^66.6.8",
    "unplugin-auto-import": "^21.0.0",
    "unplugin-vue-components": "^32.0.0",
    "vfonts": "^0.0.3",
    "vite": "^8.0.4",
    "vitest": "^4.1.5",
    "vue-tsc": "^3.2.6"
  }
}
